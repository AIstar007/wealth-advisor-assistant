# Runtime
APP_ENV=development
RUN_MODE=azure_openai
LOG_LEVEL=INFO
AUTO_APPROVE=false
DATABASE_PATH=data/wealth_advisor.db
MOCK_CRM_URL=http://127.0.0.1:8000/mock/crm
CRM_MODE=memory

# Azure OpenAI (primary assignment runtime)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# Use AZURE_OPENAI_BASE_URL instead only when you have a full /openai/v1 URL.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Optional for Azure Responses API; if omitted Agent Framework uses its default.
AZURE_OPENAI_API_VERSION=

# Optional Microsoft Foundry project mode
# RUN_MODE=foundry
# FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com
# FOUNDRY_MODEL=<model-deployment-name>

# Agent settings
AGENT_TEMPERATURE=

# Analysis thresholds
ANOMALY_Z_THRESHOLD=3.0
SPENDING_SPIKE_PCT=0.25
LOW_CASH_BUFFER_MONTHS=3
CONCENTRATION_THRESHOLD=0.50
HUMAN_REVIEW_MIN_RISK=HIGH
